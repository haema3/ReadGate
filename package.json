{
  "name": "readgate-hackathon-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "start:local": "node --env-file=.env.local server.js",
